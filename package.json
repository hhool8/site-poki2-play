{
  "name": "h5games_poki2",
  "version": "1.0.0",
  "description": "A lightweight, Poki-style HTML5 game portal. No frameworks, no build step — pure HTML / CSS / JS.",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:css": "postcss css/style.css -o dist/css/style.css && postcss css/pages.css -o dist/css/pages.css",
    "build:js": "rollup -c",
    "build:copy": "node scripts/copy-build.mjs",
    "hash:assets": "node scripts/hash-assets.cjs",
    "generate:sw": "node scripts/generate-sw.cjs",
    "validate:sw": "node scripts/validate-sw.js dist",
    "build:images": "node scripts/optimize-images.cjs dist dist",
    "generate:og": "node scripts/generate-og-images.cjs",
    "generate:gamepages": "node scripts/generate-game-pages.cjs",
    "generate:tagpages": "node scripts/generate-tag-pages.cjs",
    "generate:sitemap": "node scripts/generate-sitemap.cjs",
    "generate:category-icons": "node scripts/generate-category-icons.cjs",
    "build": "npm run generate:category-icons && npm run build:copy && npm run build:css && npm run build:js && npm run generate:gamepages && npm run generate:tagpages && npm run generate:og && npm run generate:sitemap && npm run inject:version && npm run build:images && npm run hash:assets && npm run generate:sw && npm run compress",
    "compress": "node scripts/precompress.cjs dist",
    "generate:assets": "node tools/generate-assets.js",
    "audit:links": "node tools/audit/check-game-links.js",
    "audit:sitemap": "node tools/audit/check-sitemap-urls.js",
    "audit:imgs": "node tools/audit/check-img-src.js",
    "audit:desc": "node tools/audit/check-descriptions.js",
    "audit:seo": "node tools/audit/check-seo-meta.js",
    "enrich:desc": "node tools/content/enrich-descriptions.js",
    "enrich:desc:apply": "node tools/content/enrich-descriptions.js --apply",
    "generate:howtoplay": "node scripts/generate-how-to-play.js",
    "publish:pages": "wrangler pages deploy ./dist --project-name \"${CF_PAGES_PROJECT:-play-poki2-online}\"",
    "serve:compressed": "node scripts/serve-compressed.js -p 8080 -d dist",
    "inject:version": "node scripts/inject-version.cjs",
    "_legacy:generate:icons": "node scripts/legacy/svg-to-raster.js",
    "_legacy:generate:production-icons": "node scripts/legacy/generate-production-icons.js",
    "_legacy:inject-ldjson": "node scripts/legacy/inject-ldjson.js --dir=dist --config=scripts/legacy/ldconfig.json",
    "_legacy:build:with-inject": "npm run build && npm run _legacy:inject-ldjson"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cheerio": "^1.2.0",
    "glob": "^13.0.1",
    "globby": "^16.1.0",
    "minimist": "^1.2.8",
    "playwright": "^1.58.2"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.0.0",
    "cssnano": "^7.1.2",
    "node-fetch": "^3.3.1",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "rollup": "^2.79.2",
    "rollup-plugin-terser": "^7.0.2",
    "sharp": "^0.34.5"
  },
  "optionalDependencies": {
    "fs-extra": "^11.1.1",
    "p-limit": "^4.0.0",
    "puppeteer": "^20.9.0",
    "yargs": "^17.7.2"
  },
  "type": "module"
}
